+    /**
+     * @brief CoreGraphics pen device with per-client proximity and contact state.
+     *
+     * This is event injection, not a registered HID device. Applications need
+     * proximity before point events to associate pressure with the pen. The
+     * consuming process requires macOS synthetic-input permission.
+     */
+    class MacosPenTablet final: public BackendPenTablet {
+    public:
+      /**
+       * @brief Create an independent pen event stream.
+       * @param state Shared modifier and CoreGraphics source state.
+       * @param id Runtime device identity used to correlate proximity and points.
+       */
+      MacosPenTablet(std::shared_ptr<MacosInputState> state, DeviceId id):
+          state_ {std::move(state)},
+          id_ {id} {}
+
+      ~MacosPenTablet() override {
+        static_cast<void>(close());
+      }
+
+      OperationStatus place_tool(const PenToolState &input) override {
+        std::lock_guard lock {mutex_};
+        if (!open_) {
+          return OperationStatus::failure(ErrorCode::device_closed, "macOS pen tablet is closed");
+        }
+        // Cancellation must release the last valid point even if its packet has
+        // no usable position. Never move to (0, 0) while releasing a stuck tip.
+        if (input.transition == PointerTransition::cancel || input.transition == PointerTransition::leave) {
+          return leave();
+        }
+        if (!std::isfinite(input.x) || !std::isfinite(input.y) || !std::isfinite(input.pressure) || !std::isfinite(input.distance) || !std::isfinite(input.tilt_x) || !std::isfinite(input.tilt_y)) {
+          return OperationStatus::failure(ErrorCode::invalid_argument, "macOS pen state must be finite");
+        }
+        if (input.tool == PenToolType::touch) {
+          return OperationStatus::failure(ErrorCode::unsupported_profile, "macOS pen backend does not inject finger touch");
+        }
+        const auto next_tool = input.tool == PenToolType::unchanged ? tool_ : input.tool;
+        if (in_range_ && next_tool != tool_) {
+          const auto held_buttons = barrel_;
+          const auto status = leave();
+          if (!status.ok()) {
+            return status;
+          }
+          barrel_ = held_buttons;
+        }
+        const auto bounds = mouse_viewport_bounds(input.viewport);
+        if (bounds.size.width < 1 || bounds.size.height < 1) {
+          return OperationStatus::failure(ErrorCode::backend_failure, "macOS pen viewport is unavailable");
+        }
+        location_ = {
+          bounds.origin.x + std::clamp(input.x, 0.0F, 1.0F) * std::max(0.0, bounds.size.width - 1.0),
+          bounds.origin.y + std::clamp(input.y, 0.0F, 1.0F) * std::max(0.0, bounds.size.height - 1.0),
+        };
+        tablet_x_ = static_cast<int64_t>(std::clamp(input.x, 0.0F, 1.0F) * 65535.0F);
+        tablet_y_ = static_cast<int64_t>(std::clamp(input.y, 0.0F, 1.0F) * 65535.0F);
+        tool_ = next_tool;
+        // AppKit tablet consumers (including Qt) interpret full-scale tilt as
+        // 60 degrees, and invert the vertical tablet axis relative to screen Y.
+        tilt_x_ = std::clamp(input.tilt_x / 60.0F, -1.0F, 1.0F);
+        tilt_y_ = std::clamp(-input.tilt_y / 60.0F, -1.0F, 1.0F);
+        if (input.transition == PointerTransition::release && !in_range_) {
+          return OperationStatus::success();
+        }
+        if (!in_range_) {
+          const auto status = proximity(true);
+          if (!status.ok()) {
+            return status;
+          }
+          in_range_ = true;
+          for (unsigned i = 0; i < barrel_.size(); ++i) {
+            if (barrel_[i]) {
+              const auto button_status = point(i == 0 ? kCGEventRightMouseDown : kCGEventOtherMouseDown, false, i == 0 ? kCGMouseButtonRight : kCGMouseButtonCenter);
+              if (!button_status.ok()) {
+                return button_status;
+              }
+              delivered_barrel_[i] = true;
+            }
+          }
+        }
+        const bool next_contact = input.transition == PointerTransition::update &&
+                                  (input.pressure >= 0.0F || (contact_ && input.distance < 0.0F));
+        pressure_ = next_contact ? (input.pressure < 0.0F ? pressure_ : std::clamp(input.pressure, 0.0F, 1.0F)) : 0.0F;
+        const auto type = next_contact != contact_ ? (next_contact ? kCGEventLeftMouseDown : kCGEventLeftMouseUp) :
+                                                     (next_contact ? kCGEventTabletPointer : kCGEventMouseMoved);
+        const auto status = point(type, next_contact, kCGMouseButtonLeft);
+        if (status.ok()) {
+          contact_ = next_contact;
+        }
+        return status;
+      }
+
+      OperationStatus button(PenButton button, bool pressed) override {
+        std::lock_guard lock {mutex_};
+        if (!open_) {
+          return OperationStatus::failure(ErrorCode::device_closed, "macOS pen tablet is closed");
+        }
+        // CoreGraphics exposes right and middle mouse transitions. Do not
+        // silently map a third barrel button onto a different physical button.
+        if (button != PenButton::primary && button != PenButton::secondary) {
+          return OperationStatus::failure(ErrorCode::unsupported_profile, "macOS pen supports two barrel buttons");
+        }
+        const auto index = button == PenButton::primary ? 0U : 1U;
+        if (barrel_[index] == pressed) {
+          return OperationStatus::success();
+        }
+        barrel_[index] = pressed;
+        if (!in_range_) {
+          return OperationStatus::success();
+        }
+        const auto type = index == 0 ? (pressed ? kCGEventRightMouseDown : kCGEventRightMouseUp) :
+                                       (pressed ? kCGEventOtherMouseDown : kCGEventOtherMouseUp);
+        const auto status = point(type, contact_, index == 0 ? kCGMouseButtonRight : kCGMouseButtonCenter);
+        if (status.ok()) {
+          delivered_barrel_[index] = pressed;
+        } else {
+          barrel_[index] = !pressed;
+        }
+        return status;
+      }
