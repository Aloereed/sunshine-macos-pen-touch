+  const auto r = detail::test::macos_backend_pen_actions({
+    {.state = {.x = .25F, .y = .5F, .distance = .2F}},
+    {.state = {.x = .25F, .y = .5F, .pressure = .2F}},
+    {.state = {.x = .75F, .y = .5F, .pressure = .8F}},
+    {.state = {.x = .75F, .y = .5F, .transition = PointerTransition::release}},
+  });
+  for (const auto &s : r.statuses) {
+    ASSERT_TRUE(s.ok());
+  }
+  ASSERT_EQ(r.events.size(), 6U);
+  EXPECT_EQ(r.events[0].type, kCGEventTabletProximity);
+  EXPECT_TRUE(r.events[0].entering);
+  EXPECT_EQ(r.events[1].type, kCGEventMouseMoved);
+  EXPECT_EQ(r.events[2].type, kCGEventLeftMouseDown);
+  EXPECT_EQ(r.events[3].type, kCGEventTabletPointer);
+  EXPECT_NEAR(r.events[3].pressure, .8, .0001);
+  EXPECT_EQ(r.events[3].buttons, 1);
+  EXPECT_EQ(r.events[4].type, kCGEventLeftMouseUp);
+  EXPECT_EQ(r.events[4].pressure, 0);
+  EXPECT_EQ(r.events[5].type, kCGEventTabletProximity);
+  EXPECT_FALSE(r.events[5].entering);
+  for (const auto &e : r.events) {
+    EXPECT_EQ(e.device, 42);
+  }
+}
+
+TEST_F(MacosBackendTest, PenCancelReleasesLastPositionEvenWithInvalidCoordinates) {
+  using namespace lvh;
+  const auto r = detail::test::macos_backend_pen_actions({
+    {.state = {.x = .5F, .y = .5F, .pressure = .7F}},
+    {.state = {.x = std::numeric_limits<float>::quiet_NaN(), .transition = PointerTransition::cancel}},
+  });
+  ASSERT_EQ(r.events.size(), 4U);
+  EXPECT_TRUE(r.statuses.back().ok());
+  EXPECT_EQ(r.events[2].type, kCGEventLeftMouseUp);
+  EXPECT_EQ(r.events[2].x, r.events[1].x);
+  EXPECT_EQ(r.events[2].y, r.events[1].y);
+  EXPECT_EQ(r.events[2].pressure, 0);
+  EXPECT_FALSE(r.events[3].entering);
+}
+
+TEST_F(MacosBackendTest, PenMapsRetinaPointsNegativeOriginAndClampsPressureTilt) {
+  using namespace lvh;
+  const auto r = detail::test::macos_backend_pen_actions({
+    {.state = {.x = -1, .y = 2, .pressure = 2, .tilt_x = 120, .tilt_y = -120, .viewport = {.offset_x = -1440, .offset_y = 50, .width = 1440, .height = 810}}},
+  });
+  ASSERT_TRUE(r.statuses[0].ok());
+  ASSERT_GE(r.events.size(), 2U);
+  EXPECT_EQ(r.events[1].x, -1440);
+  EXPECT_EQ(r.events[1].y, 859);
+  EXPECT_EQ(r.events[1].pressure, 1);
+  EXPECT_EQ(r.events[1].tilt_x, 1);
+  EXPECT_EQ(r.events[1].tilt_y, 1);
+}
+
+TEST_F(MacosBackendTest, PenToolSwitchReleasesOldTipBeforeEraserProximity) {
+  using namespace lvh;
+  const auto r = detail::test::macos_backend_pen_actions({
+    {.state = {.pressure = .2F}},
+    {.state = {.tool = PenToolType::eraser, .pressure = .6F}},
+  });
+  ASSERT_EQ(r.events.size(), 8U);
+  EXPECT_EQ(r.events[2].type, kCGEventLeftMouseUp);
+  EXPECT_FALSE(r.events[3].entering);
+  EXPECT_TRUE(r.events[4].entering);
+  EXPECT_EQ(r.events[4].tool, 3);
+  EXPECT_EQ(r.events[5].type, kCGEventLeftMouseDown);
+}
+
+TEST_F(MacosBackendTest, PenRejectsNonFiniteInputsAndFingerToolWithoutPosting) {
+  using namespace lvh;
+  const auto r = detail::test::macos_backend_pen_actions({
+    {.state = {.pressure = std::numeric_limits<float>::infinity()}},
+    {.state = {.x = std::numeric_limits<float>::quiet_NaN()}},
+    {.state = {.tool = PenToolType::touch}},
+  });
+  EXPECT_TRUE(r.events.empty());
+  EXPECT_EQ(r.statuses[0].code(), ErrorCode::invalid_argument);
+  EXPECT_EQ(r.statuses[1].code(), ErrorCode::invalid_argument);
+  EXPECT_EQ(r.statuses[2].code(), ErrorCode::unsupported_profile);
+}
+
+TEST_F(MacosBackendTest, PenCloseReleasesBarrelAndTipAndRejectsSubsequentInput) {
+  using namespace lvh;
+  const auto r = detail::test::macos_backend_pen_actions({
+    {.state = {.pressure = .5F}},
+    {.button = std::pair {PenButton::primary, true}},
+    {.button = std::pair {PenButton::secondary, true}},
+    {.close = true},
+    {.state = {.pressure = .8F}},
+    {.button = std::pair {PenButton::primary, true}},
+    {.close = true},
+  });
+  ASSERT_EQ(r.events.size(), 8U);
+  EXPECT_EQ(r.events[2].type, kCGEventRightMouseDown);
+  EXPECT_EQ(r.events[3].type, kCGEventOtherMouseDown);
+  EXPECT_EQ(r.events[4].type, kCGEventLeftMouseUp);
+  EXPECT_EQ(r.events[5].type, kCGEventRightMouseUp);
+  EXPECT_EQ(r.events[6].type, kCGEventOtherMouseUp);
+  EXPECT_FALSE(r.events[7].entering);
+  EXPECT_EQ(r.statuses[4].code(), ErrorCode::device_closed);
+  EXPECT_EQ(r.statuses[5].code(), ErrorCode::device_closed);
+  EXPECT_TRUE(r.statuses[6].ok());
+}
+
+TEST_F(MacosBackendTest, PenZeroPressureStillStartsContactAndHoverEndsIt) {
+  using namespace lvh;
+  const auto r = detail::test::macos_backend_pen_actions({
+    {.state = {.pressure = 0}},
+    {.state = {.tool = PenToolType::unchanged, .pressure = .3F}},
+    {.state = {.distance = .1F}},
+  });
+  ASSERT_EQ(r.events.size(), 5U);
+  EXPECT_EQ(r.events[1].type, kCGEventLeftMouseDown);
+  EXPECT_EQ(r.events[1].buttons, 1);
+  EXPECT_EQ(r.events[2].type, kCGEventTabletPointer);
+  EXPECT_EQ(r.events[3].type, kCGEventLeftMouseUp);
+}
+
+TEST_F(MacosBackendTest, PenQueuedBarrelButtonBeginsAtFirstKnownLocation) {
+  using namespace lvh;
+  const auto r = detail::test::macos_backend_pen_actions({
+    {.button = std::pair {PenButton::primary, true}},
+    {.state = {.x = .5F, .y = .5F, .pressure = .5F}},
+  });
+  ASSERT_EQ(r.events.size(), 6U);
+  EXPECT_EQ(r.events[0].type, kCGEventTabletProximity);
+  EXPECT_EQ(r.events[1].type, kCGEventRightMouseDown);
+  EXPECT_EQ(r.events[1].x, 719.5);
+  EXPECT_EQ(r.events[1].y, 404.5);
+  EXPECT_EQ(r.events[2].type, kCGEventLeftMouseDown);
+  EXPECT_EQ(r.events[3].type, kCGEventLeftMouseUp);
+  EXPECT_EQ(r.events[4].type, kCGEventRightMouseUp);
+}
+
+TEST_F(MacosBackendTest, PenPreservesPressureSentinelAndConvertsTiltForAppKit) {
+  using namespace lvh;
+  const auto r = detail::test::macos_backend_pen_actions({
+    {.state = {.pressure = .375F}},
+    {.state = {.tilt_x = 15, .tilt_y = -30}},
+  });
+  ASSERT_GE(r.events.size(), 3U);
+  EXPECT_EQ(r.events[2].type, kCGEventTabletPointer);
+  EXPECT_NEAR(r.events[2].pressure, .375, .0001);
+  EXPECT_NEAR(r.events[2].tilt_x, .25, .0001);
+  EXPECT_NEAR(r.events[2].tilt_y, .5, .0001);
 }
