+      CGEventRef event(CGEventType type) const {
+        const auto result = CGEventCreate(state_->source);
+        if (result) {
+          CGEventSetType(result, type);
+          CGEventSetLocation(result, location_);
+          CGEventSetTimestamp(result, std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+          std::lock_guard lock {state_->keyboard_mutex};
+          CGEventSetFlags(result, state_->keyboard_flags);
+        }
+        return result;
+      }
+
+      /**
+       * @brief Announce or retire the device before delivering tablet points.
+       * @param entering Whether the pen is entering range.
+       * @return Allocation/delivery status.
+       */
+      OperationStatus proximity(bool entering) {
+        const auto e = event(kCGEventTabletProximity);
+        if (!e) {
+          return OperationStatus::failure(ErrorCode::backend_failure, "cannot create macOS pen proximity event");
+        }
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventDeviceID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventPointerID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventSystemTabletID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventTabletID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventVendorUniqueID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventVendorPointerSerialNumber, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventPointerType, tool_ == PenToolType::eraser ? 3 : 1);
+        // X, Y, buttons, pressure, tilt X/Y and device ID, without claiming
+        // tangential pressure, rotation or vendor-specific features.
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventCapabilityMask, 0x7f);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventEnterProximity, entering);
+        CGEventPost(kCGHIDEventTap, e);
+        CFRelease(e);
+        return OperationStatus::success();
+      }
+
+      /**
+       * @brief Post a tablet point or a mouse transition carrying tablet data.
+       * @param type CoreGraphics pointer event type.
+       * @param contact Whether the tip is touching.
+       * @param button Mouse button associated with a transition.
+       * @return Allocation/delivery status.
+       */
+      OperationStatus point(CGEventType type, bool contact, CGMouseButton button) {
+        const auto e = event(type);
+        if (!e) {
+          return OperationStatus::failure(ErrorCode::backend_failure, "cannot create macOS pen point event");
+        }
+        CGEventSetIntegerValueField(e, kCGMouseEventSubtype, kCGEventMouseSubtypeTabletPoint);
+        CGEventSetIntegerValueField(e, kCGMouseEventButtonNumber, button);
+        CGEventSetIntegerValueField(e, kCGMouseEventClickState, 1);
+        CGEventSetIntegerValueField(e, kCGTabletEventDeviceID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletEventPointButtons, (contact ? 1 : 0) | (barrel_[0] ? 2 : 0) | (barrel_[1] ? 4 : 0));
+        CGEventSetDoubleValueField(e, kCGMouseEventPressure, contact ? pressure_ : 0.0);
+        CGEventSetDoubleValueField(e, kCGTabletEventPointPressure, contact ? pressure_ : 0.0);
+        CGEventSetDoubleValueField(e, kCGTabletEventTiltX, tilt_x_);
+        CGEventSetDoubleValueField(e, kCGTabletEventTiltY, tilt_y_);
+        CGEventSetIntegerValueField(e, kCGTabletEventPointX, tablet_x_);
+        CGEventSetIntegerValueField(e, kCGTabletEventPointY, tablet_y_);
+        // Tablet-point events retain 16-bit pressure, whereas mouse subtype
+        // events lose precision in AppKit. They do not move the cursor themselves.
+        if (type == kCGEventTabletPointer) {
+          CGWarpMouseCursorPosition(location_);
+        }
+        CGEventPost(kCGHIDEventTap, e);
+        CFRelease(e);
+        return OperationStatus::success();
+      }
+
+      /**
+       * @brief Release contact and barrel buttons before retiring proximity.
+       * @return First delivery failure, or success for an already inactive pen.
+       */
+      OperationStatus leave() {
+        if (!in_range_) {
+          barrel_ = {};
+          return OperationStatus::success();
+        }
+        pressure_ = 0.0F;
+        if (contact_) {
+          const auto status = point(kCGEventLeftMouseUp, false, kCGMouseButtonLeft);
+          if (!status.ok()) {
+            return status;
+          }
+          contact_ = false;
+        }
+        for (unsigned i = 0; i < barrel_.size(); ++i) {
+          if (delivered_barrel_[i]) {
+            barrel_[i] = false;
+            const auto status = point(i == 0 ? kCGEventRightMouseUp : kCGEventOtherMouseUp, false, i == 0 ? kCGMouseButtonRight : kCGMouseButtonCenter);
+            if (!status.ok()) {
+              barrel_[i] = true;
+              return status;
+            }
+            delivered_barrel_[i] = false;
+          }
+        }
+        barrel_ = {};
+        const auto status = proximity(false);
+        if (status.ok()) {
+          in_range_ = false;
+        }
+        return status;
+      }
+
+      std::shared_ptr<MacosInputState> state_;  ///< Shared native event source and modifier flags.
+      DeviceId id_;  ///< Runtime identity shared by proximity and point events.
+      CGPoint location_ {};  ///< Last valid desktop position in screen points.
+      int64_t tablet_x_ = 0;  ///< Non-negative tablet-space horizontal coordinate.
+      int64_t tablet_y_ = 0;  ///< Non-negative tablet-space vertical coordinate.
+      PenToolType tool_ = PenToolType::pen;  ///< Active tool, preserved for unchanged updates.
+      float pressure_ = 0;  ///< Last normalized tip pressure.
+      float tilt_x_ = 0;  ///< Normalized CoreGraphics horizontal tilt.
+      float tilt_y_ = 0;  ///< Normalized CoreGraphics vertical tilt.
+      std::array<bool, 2> barrel_ {};  ///< Primary and secondary barrel-button states.
+      std::array<bool, 2> delivered_barrel_ {};  ///< Barrel downs actually delivered while in range.
+      bool contact_ = false;  ///< Whether a tip-down transition has been posted.
+      bool in_range_ = false;  ///< Whether enter-proximity has been posted.
+      bool open_ = true;  ///< Reject submissions once explicitly closed.
+      std::mutex mutex_;  ///< Serialize per-device transitions and teardown.
+    };
+
