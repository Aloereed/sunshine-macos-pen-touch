+TEST_F(VirtualHidDeviceTest, PenTakesPriorityOverFingerAndRequiresFreshFingerDownAfterRelease) {
+  client()->touch.reset();
+  client()->touch_mouse = context()->runtime->create_mouse().mouse;
+  auto &mouse = *client()->touch_mouse;
+  platf::touch_input_t touch {};
+  touch.eventType = LI_TOUCH_EVENT_DOWN;
+  touch.x = touch.y = 0.5F;
+  platf::virtualhid::touch_update(*client(), {}, touch);
+  ASSERT_TRUE(client()->touch_mouse_id);
+  platf::pen_input_t pen {};
+  pen.eventType = LI_TOUCH_EVENT_DOWN;
+  pen.toolType = LI_TOOL_TYPE_PEN;
+  pen.pressureOrDistance = 0.5F;
+  platf::virtualhid::pen_update(*client(), {}, pen);
+  EXPECT_TRUE(client()->pen_contact);
+  EXPECT_FALSE(client()->touch_mouse_id);
+  EXPECT_FALSE(mouse.last_submitted_event().pressed);
+  const auto count = mouse.submit_count();
+  platf::virtualhid::touch_update(*client(), {}, touch);
+  EXPECT_EQ(mouse.submit_count(), count);
+  pen.eventType = LI_TOUCH_EVENT_BUTTON_ONLY;
+  platf::virtualhid::pen_update(*client(), {}, pen);
+  EXPECT_TRUE(client()->pen_contact);
+  pen.eventType = LI_TOUCH_EVENT_UP;
+  platf::virtualhid::pen_update(*client(), {}, pen);
+  EXPECT_FALSE(client()->pen_contact);
+  touch.eventType = LI_TOUCH_EVENT_MOVE;
+  platf::virtualhid::touch_update(*client(), {}, touch);
+  EXPECT_EQ(mouse.submit_count(), count);
+  touch.eventType = LI_TOUCH_EVENT_DOWN;
+  platf::virtualhid::touch_update(*client(), {}, touch);
+  EXPECT_TRUE(client()->touch_mouse_id);
+  platf::virtualhid::reset_client_pointers(*client());
+  EXPECT_FALSE(client()->touch_mouse_id);
+  EXPECT_FALSE(mouse.last_submitted_event().pressed);
+}
