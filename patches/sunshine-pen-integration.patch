+     * @brief Translate one finger to mouse clicks and drags on the main display.
+     * @param context Per-client fallback state; additional contacts are ignored.
+     * @param touch Contact in normalized capture coordinates.
+     */
+    void touch_mouse_update(client_context_t &context, const touch_input_t &touch) {
+      if (!context.touch_mouse) {
+        return;
+      }
+      if (touch.eventType == LI_TOUCH_EVENT_CANCEL_ALL) {
+        release_touch_mouse(context);
+        return;
+      }
+      if (touch.eventType == LI_TOUCH_EVENT_UP || touch.eventType == LI_TOUCH_EVENT_CANCEL || touch.eventType == LI_TOUCH_EVENT_HOVER_LEAVE) {
+        if (context.touch_mouse_id == touch.pointerId) {
+          release_touch_mouse(context);
+        }
+        return;
+      }
+      if (context.pen_contact || !std::isfinite(touch.x) || !std::isfinite(touch.y)) {
+        return;
+      }
+      if (touch.eventType != LI_TOUCH_EVENT_DOWN && touch.eventType != LI_TOUCH_EVENT_MOVE) {
+        return;
+      }
+      if (context.touch_mouse_id && context.touch_mouse_id != touch.pointerId) {
+        return;
+      }
+      // Never promote an already held second finger/palm after the first contact
+      // or the pen is released. Only a fresh DOWN can start a new mouse drag.
+      if (!context.touch_mouse_id && touch.eventType != LI_TOUCH_EVENT_DOWN) {
+        return;
+      }
+      const auto move = context.touch_mouse->move_absolute(
+        static_cast<std::int32_t>(std::lround(std::clamp(touch.x, 0.0F, 1.0F) * 65535.0F)),
