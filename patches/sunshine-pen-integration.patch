+TEST_F(VirtualHidDeviceTest, FingerFallbackClicksDragsAndReleasesOnlyItsOwningContact) {
+  client()->touch.reset();
+  client()->touch_mouse = context()->runtime->create_mouse().mouse;
+  ASSERT_TRUE(client()->touch_mouse);
+  auto &mouse = *client()->touch_mouse;
+  platf::touch_input_t touch {};
+  touch.eventType = LI_TOUCH_EVENT_DOWN;
+  touch.pointerId = 10;
+  touch.x = 0.25F;
+  touch.y = 0.75F;
+  platf::virtualhid::touch_update(*client(), {}, touch);
+  EXPECT_EQ(mouse.submit_count(), 2);
+  EXPECT_TRUE(mouse.last_submitted_event().pressed);
+  EXPECT_EQ(client()->touch_mouse_id, 10U);
+
+  touch.pointerId = 11;
+  platf::virtualhid::touch_update(*client(), {}, touch);
+  touch.eventType = LI_TOUCH_EVENT_UP;
+  platf::virtualhid::touch_update(*client(), {}, touch);
+  EXPECT_EQ(mouse.submit_count(), 2);
+  EXPECT_EQ(client()->touch_mouse_id, 10U);
+
+  touch.pointerId = 10;
+  touch.eventType = LI_TOUCH_EVENT_MOVE;
+  touch.x = 0.5F;
+  platf::virtualhid::touch_update(*client(), {}, touch);
+  EXPECT_EQ(mouse.last_submitted_event().kind, lvh::MouseEventKind::absolute_motion);
+  EXPECT_EQ(mouse.last_submitted_event().x, 32768);
+  EXPECT_EQ(mouse.last_submitted_event().width, 65535);
+  touch.eventType = LI_TOUCH_EVENT_UP;
+  platf::virtualhid::touch_update(*client(), {}, touch);
+  EXPECT_FALSE(mouse.last_submitted_event().pressed);
+  EXPECT_FALSE(client()->touch_mouse_id);
+}
