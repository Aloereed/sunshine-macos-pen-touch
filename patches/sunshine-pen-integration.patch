+TEST_F(VirtualHidDeviceTest, PenButtonOnlyDoesNotReplacePressureOrPosition) {
+  const platf::touch_port_t viewport {1, 2, 1000, 500, 1000, 500};
+  platf::pen_input_t pen {
+    LI_TOUCH_EVENT_DOWN,
+    LI_TOOL_TYPE_PEN,
+    0,
+    LI_TILT_UNKNOWN,
+    LI_ROT_UNKNOWN,
+    0.25F,
+    0.75F,
+    0.65F,
+    0.0F,
+    0.0F,
+  };
+  platf::virtualhid::pen_update(*client(), viewport, pen);
+  pen.eventType = LI_TOUCH_EVENT_BUTTON_ONLY;
+  pen.toolType = LI_TOOL_TYPE_UNKNOWN;
+  pen.penButtons = LI_PEN_BUTTON_PRIMARY;
+  pen.x = pen.y = pen.pressureOrDistance = 0;
+  platf::virtualhid::pen_update(*client(), viewport, pen);
+  const auto state = client()->pen->last_submitted_tool();
+  EXPECT_FLOAT_EQ(state.x, 0.25F);
+  EXPECT_FLOAT_EQ(state.y, 0.75F);
+  EXPECT_FLOAT_EQ(state.pressure, 0.65F);
+  EXPECT_EQ(state.tool, lvh::PenToolType::pen);
+  EXPECT_EQ(state.transition, lvh::PointerTransition::update);
+  EXPECT_TRUE(client()->pressed_pen_buttons.contains(lvh::PenButton::primary));
+}
