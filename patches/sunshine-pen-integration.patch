+TEST_F(VirtualHidDeviceTest, DisconnectCancelsRetainedTouchAndPenWithoutClosingDevices) {
+  const platf::touch_port_t viewport {0, 0, 1440, 810, 1440, 810};
+  platf::touch_input_t touch {};
+  touch.eventType = LI_TOUCH_EVENT_DOWN;
+  touch.pointerId = 7;
+  touch.x = touch.y = 0.5F;
+  platf::virtualhid::touch_update(*client(), viewport, touch);
+  platf::pen_input_t pen {};
+  pen.eventType = LI_TOUCH_EVENT_DOWN;
+  pen.toolType = LI_TOOL_TYPE_PEN;
+  pen.penButtons = LI_PEN_BUTTON_PRIMARY;
+  pen.pressureOrDistance = 0.6F;
+  platf::virtualhid::pen_update(*client(), viewport, pen);
+  ASSERT_FALSE(client()->active_touches.empty());
+  ASSERT_FALSE(client()->pressed_pen_buttons.empty());
+
+  platf::virtualhid::reset_client_pointers(*client());
+  EXPECT_TRUE(client()->active_touches.empty());
+  EXPECT_TRUE(client()->pressed_pen_buttons.empty());
+  EXPECT_EQ(client()->pen->last_submitted_tool().transition, lvh::PointerTransition::cancel);
+  EXPECT_TRUE(client()->pen->is_open());
+  EXPECT_TRUE(client()->touch->is_open());
+
+  pen.penButtons = 0;
+  platf::virtualhid::pen_update(*client(), viewport, pen);
+  EXPECT_EQ(client()->pen->last_submitted_tool().transition, lvh::PointerTransition::update);
+  EXPECT_FLOAT_EQ(client()->pen->last_submitted_tool().pressure, 0.6F);
+}
