+        if (!e) {
+          return OperationStatus::failure(ErrorCode::backend_failure, "cannot create macOS pen proximity event");
+        }
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventDeviceID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventPointerID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventSystemTabletID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventTabletID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventVendorUniqueID, id_);
+        CGEventSetIntegerValueField(e, kCGTabletProximityEventVendorPointerSerialNumber, id_);
