+    private:
+      /**
+       * @brief Allocate an event preserving shared keyboard modifiers.
+       * @param type Native event type.
+       * @return Owned CoreGraphics event, or null on allocation failure.
+       */
+      CGEventRef event(CGEventType type) const {
+        const auto result = CGEventCreate(state_->source);
+        if (result) {
+          CGEventSetType(result, type);
+          CGEventSetLocation(result, location_);
